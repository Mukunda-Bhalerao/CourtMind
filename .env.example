# Copy to .env for local development. Never commit the real .env.

# --- LLM fact extraction (optional) ---------------------------------------
# true  → call Ollama to extract facts (falls back to keywords on failure)
# false → keyword extraction only (what the free Render deploy uses)
LLM_EXTRACTION=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Only for Ollama Cloud (OLLAMA_BASE_URL=https://ollama.com)
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=60

# --- Research APIs (optional, shown in the Full Report) --------------------
SERPER_API_KEY=
KANOON_API_KEY=
